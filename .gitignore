*/.ipynb_checkpoints/*

# ==========================================
# Данные (персональные ЭЭГ и тяжелые файлы)
# ==========================================
# Игнорируем все папки с исходными данными
data/raw/
data/raw_new/
data/clean/
data/processed/
# Игнорируем любые файлы ЭЭГ
*.edf
*.bdf
*.fif
# Игнорируем любые промежуточные CSV, кроме метаданных, если они не нужны
# data/*.csv  (раскомментируйте, если не хотите делиться даже CSV)

# ==========================================
# Модели и артефакты (бинарники)
# ==========================================
# Обученные модели обычно слишком тяжелые для Git. 
# Если рекрутеру нужно их видеть, используйте Git LFS или облако (Google Drive).
*.pkl
*.pickle
*.joblib
*.h5
*.onnx

# ==========================================
# Результаты экспериментов (старые/промежуточные)
# ==========================================
# Оставляем только итоговые графики и метрики, а архив с экспериментами скрываем
results/_archive/

